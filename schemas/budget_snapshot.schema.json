{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdv-governor.local/schemas/budget_snapshot.schema.json",
  "title": "SDV Eight-Class Resource Budget Snapshot Schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tick_seq",
    "sim_time_s",
    "vessel_mode",
    "feasible",
    "infeasible_protected_load",
    "infeasible_reason",
    "binding_witnesses",
    "classes"
  ],
  "properties": {
    "tick_seq": { "type": "integer", "minimum": 0 },
    "sim_time_s": { "type": "integer", "minimum": 0 },
    "vessel_mode": { "type": "string" },
    "feasible": { "type": "boolean" },
    "infeasible_protected_load": { "type": "boolean" },
    "infeasible_reason": { "type": ["string", "null"] },
    "binding_witnesses": { "type": "array" },
    "classes": {
      "type": "object",
      "required": ["power", "cooling", "positions", "mast", "mass_stability", "data", "compute", "time"]
    },
    "air_domains": { "type": "object" },
    "air_total_actual_w": { "type": "integer", "minimum": 0 },
    "air_total_committed_w": { "type": "integer", "minimum": 0 },
    "all_air_domains_feasible": { "type": "boolean" },
    "component_allocations": { "type": "object" },
    "component_breakdown": { "type": ["object", "array"] },
    "component_ledger": { "type": "object" },
    "firm_reservations": { "type": ["array", "object"] },
    "roof_clearance": { "type": "object" },
    "roof_clearance_verification": { "type": "object" },
    "pending_transitions": { "type": "array" },
    "run_id": { "type": "string" },
    "snapshot_version": { "type": "integer", "minimum": 0 },
    "connection_state": { "type": "string" },
    "source": { "type": "string" }
  }
}
