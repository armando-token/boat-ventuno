{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdv-governor.local/schemas/ship_profile.schema.json",
  "title": "SDV Ship Profile Schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "vessel_id",
    "vessel_name",
    "power",
    "cooling",
    "positions",
    "mast",
    "mass_and_stability",
    "data_links",
    "compute_rack",
    "time_deadlines"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "sdv-ship-baseline/1.0" },
    "vessel_id": { "type": "string", "minLength": 1 },
    "vessel_name": { "type": "string", "minLength": 1 },
    "power": { "type": "object" },
    "cooling": { "type": "object" },
    "positions": { "type": "object" },
    "mast": { "type": "object" },
    "mass_and_stability": { "type": "object" },
    "data_links": { "type": "object" },
    "compute_rack": { "type": "object" },
    "time_deadlines": { "type": "object" },
    "air_cooling_domains": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capacity_w", "positions", "value_origin"],
        "properties": {
          "capacity_w": { "type": "integer", "minimum": 0 },
          "positions": { "type": "array", "items": { "type": "string" } },
          "value_origin": {
            "type": "string",
            "enum": ["OFFICIAL_BRIEF", "ORGANIZER_ERRATA", "ASSUMED"]
          },
          "source_ref": { "type": "string" },
          "assumption_ref": { "type": "string" }
        }
      }
    },
    "roof_drone_clearance_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_id",
        "policy_version",
        "layout_version",
        "constraint_id",
        "assumption_ref",
        "value_origin",
        "compatibility",
        "antenna_zone",
        "excluded_zones",
        "requires_installation_verification",
        "invalidated_by"
      ],
      "properties": {
        "policy_id": { "type": "string", "minLength": 1 },
        "policy_version": { "type": "integer", "minimum": 1 },
        "layout_version": { "type": "string", "minLength": 1 },
        "constraint_id": { "type": "string", "minLength": 1 },
        "assumption_ref": { "type": "string", "minLength": 1 },
        "value_origin": {
          "type": "string",
          "enum": ["OFFICIAL_BRIEF", "ORGANIZER_ERRATA", "ASSUMED"]
        },
        "compatibility": {
          "type": "string",
          "enum": ["CONDITIONAL", "COMPATIBLE", "CONFLICT"]
        },
        "antenna_zone": { "type": "string" },
        "excluded_zones": { "type": "array", "items": { "type": "string" } },
        "requires_installation_verification": { "type": "boolean" },
        "invalidated_by": { "type": "array", "items": { "type": "string" } }
      }
    },
    "transition_timing_policy": { "type": "object" }
  }
}
