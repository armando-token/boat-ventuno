{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdv-governor.local/schemas/guest_manifest.schema.json",
  "title": "SDV Guest Card Manifest Schema (B.0)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "guest_id",
    "name",
    "category",
    "safety_critical",
    "default_mode",
    "can_buffer_offline",
    "subcomponents",
    "modes",
    "installation",
    "vehicle_replacement",
    "ship_state_constraints",
    "dependencies",
    "mission_capabilities"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "sdv-guest-manifest/1.0" },
    "guest_id": { "type": "string", "pattern": "^[A-Z0-9_\\-]+$" },
    "name": { "type": "string", "minLength": 3 },
    "category": {
      "type": "string",
      "enum": [
        "PASSIVE_RADIO_SENSOR",
        "OCEAN_WEATHER_MODULE",
        "AUV_HYDRO_SURVEY",
        "UAV_SAR_SURVEILLANCE",
        "EMERGENCY_COMMS_EDGE_COMPUTE",
        "CIVIL_HYDRO_SAMPLER",
        "METEO_SENSOR",
        "ROV_INSPECTION",
        "AUV_SURVEY",
        "UAV_SAR",
        "AUXILIARY_PAYLOAD"
      ]
    },
    "safety_critical": { "type": "boolean" },
    "default_mode": { "type": "string", "minLength": 1 },
    "can_buffer_offline": { "type": "boolean" },
    "mission_capabilities": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "number", "minimum": 0.0, "maximum": 100.0 }
    },
    "logical_workload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "compute", "satcom_bps", "capability_fraction", "provenance"],
      "properties": {
        "description": { "type": "string", "minLength": 1 },
        "compute": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cores", "memory_gib", "accelerators"],
          "properties": {
            "cores": { "type": "integer", "minimum": 1 },
            "memory_gib": { "type": "integer", "minimum": 1 },
            "accelerators": { "type": "integer", "minimum": 0 }
          }
        },
        "satcom_bps": { "type": "integer", "minimum": 0 },
        "capability_fraction": { "type": "number", "minimum": 0.01, "maximum": 1.0 },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["compute", "capability_fraction"],
          "properties": {
            "compute": { "type": "string", "enum": ["OFFICIAL_BRIEF", "ORGANIZER_ERRATA", "ASSUMED"] },
            "capability_fraction": { "type": "string", "enum": ["OFFICIAL_BRIEF", "ORGANIZER_ERRATA", "ASSUMED"] }
          }
        }
      }
    },
    "subcomponents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "subcomponent_id",
          "part_of",
          "name",
          "mass_kg",
          "footprint_m2",
          "wind_area_m2",
          "preferred_positions",
          "allowed_positions",
          "cooling_route",
          "requires_water_manifold",
          "value_origin"
        ],
        "properties": {
          "subcomponent_id": { "type": "string", "minLength": 2 },
          "part_of": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "mass_kg": { "type": "integer", "minimum": 1 },
          "footprint_m2": { "type": "number", "exclusiveMinimum": 0.0 },
          "wind_area_m2": { "type": "number", "minimum": 0.0 },
          "preferred_positions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": ["mast_1", "mast_2", "mast_3", "hangar", "hangar_roof", "flight_deck", "bay1", "bay1_a", "bay1_b", "bay2"]
            }
          },
          "allowed_positions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": ["mast_1", "mast_2", "mast_3", "hangar", "hangar_roof", "flight_deck", "bay1", "bay1_a", "bay1_b", "bay2"]
            }
          },
          "cooling_route": {
            "type": "string",
            "enum": ["CHILLED_WATER_LOOP", "MAST_AIR_2KW", "PASSIVE_NO_COOLING", "MAST_AIR", "PASSIVE_AMBIENT"]
          },
          "requires_water_manifold": { "type": "boolean" },
          "value_origin": {
            "type": "string",
            "enum": ["OFFICIAL_BRIEF", "ORGANIZER_ERRATA", "ASSUMED"]
          },
          "field_origins": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "enum": ["OFFICIAL_BRIEF", "ORGANIZER_ERRATA", "ASSUMED"]
            }
          },
          "provenance_metadata": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "source_id": { "type": "string" },
              "derivation_expression": { "type": "string" },
              "inputs": { "type": "object" },
              "derived_mass_kg": { "type": "integer" },
              "superseded_value": { "type": "object" }
            }
          }
        }
      }
    },
    "modes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "description",
          "min_power_w",
          "nominal_power_w",
          "sustained_power_w",
          "sustained_duration_s",
          "peak_power_w",
          "peak_duration_s",
          "cooling_water_w",
          "cooling_air_mast_w",
          "compute_cores",
          "compute_ram_mib",
          "compute_accelerators",
          "shared_storage_gb",
          "backbone_lan_bps",
          "satcom_bps",
          "safety_critical",
          "uninterruptible",
          "min_done_duration_s",
          "min_cooldown_s",
          "forbids_emcon_silence",
          "requires_deck_clear",
          "requires_quiet_acoustic_state",
          "capability_retention_ratio",
          "value_origin"
        ],
        "properties": {
          "description": { "type": "string", "minLength": 1 },
          "min_power_w": { "type": "integer", "minimum": 0 },
          "nominal_power_w": { "type": "integer", "minimum": 0 },
          "sustained_power_w": { "type": "integer", "minimum": 0 },
          "sustained_duration_s": { "type": "integer", "minimum": 0 },
          "peak_power_w": { "type": "integer", "minimum": 0 },
          "peak_duration_s": { "type": "integer", "minimum": 0 },
          "cooling_water_w": { "type": "integer", "minimum": 0 },
          "cooling_air_mast_w": { "type": "integer", "minimum": 0, "maximum": 2000 },
          "compute_cores": { "type": "integer", "minimum": 0 },
          "compute_ram_mib": { "type": "integer", "minimum": 0 },
          "compute_accelerators": { "type": "integer", "minimum": 0 },
          "shared_storage_gb": { "type": "integer", "minimum": 0 },
          "backbone_lan_bps": { "type": "integer", "minimum": 0 },
          "satcom_bps": { "type": "integer", "minimum": 0 },
          "safety_critical": { "type": "boolean" },
          "uninterruptible": { "type": "boolean" },
          "min_done_duration_s": { "type": "integer", "minimum": 0 },
          "min_cooldown_s": { "type": "integer", "minimum": 0 },
          "forbids_emcon_silence": { "type": "boolean" },
          "requires_deck_clear": { "type": "boolean" },
          "requires_quiet_acoustic_state": { "type": "boolean" },
          "capability_retention_ratio": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
          "value_origin": {
            "type": "string",
            "enum": ["OFFICIAL_BRIEF", "ORGANIZER_ERRATA", "ASSUMED"]
          },
          "field_origins": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "enum": ["OFFICIAL_BRIEF", "ORGANIZER_ERRATA", "ASSUMED"]
            }
          }
        }
      }
    },
    "installation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "port_only",
        "min_crew_required",
        "install_time_min",
        "remove_time_min",
        "sea_install_max_wind_kn",
        "sea_install_min_speed_kn",
        "sea_install_max_speed_kn"
      ],
      "properties": {
        "port_only": { "type": "boolean" },
        "min_crew_required": { "type": "integer", "minimum": 0 },
        "install_time_min": { "type": "integer", "minimum": 1 },
        "remove_time_min": { "type": "integer", "minimum": 1 },
        "sea_install_max_wind_kn": { "type": "integer", "minimum": 0 },
        "sea_install_min_speed_kn": { "type": "number", "minimum": 0.0 },
        "sea_install_max_speed_kn": { "type": "number", "minimum": 0.0 },
        "antenna_min_crew_required": { "type": "integer", "minimum": 0 },
        "antenna_install_time_min": { "type": "integer", "minimum": 0 }
      }
    },
    "vehicle_replacement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "supported_at_sea",
        "min_crew_required",
        "swap_duration_min",
        "min_speed_kn",
        "max_speed_kn",
        "max_wind_kn",
        "max_sea_state"
      ],
      "properties": {
        "supported_at_sea": { "type": "boolean" },
        "min_crew_required": { "type": "integer", "minimum": 0 },
        "swap_duration_min": { "type": "integer", "minimum": 0 },
        "min_speed_kn": { "type": "number", "minimum": 0.0 },
        "max_speed_kn": { "type": "number", "minimum": 0.0 },
        "max_wind_kn": { "type": "integer", "minimum": 0 },
        "max_sea_state": { "type": "integer", "minimum": 0, "maximum": 9 }
      }
    },
    "ship_state_constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min_speed_kn_for_operation",
        "max_speed_kn_for_operation",
        "max_wind_kn_for_operation",
        "max_sea_state_for_operation",
        "requires_heading_into_wind_for_launch_recovery",
        "forbids_deck_machinery_while_active",
        "acoustic_hold_handshake_min_s",
        "acoustic_hold_handshake_max_s",
        "acoustic_hold_default_s",
        "low_battery_threshold_pct",
        "emergency_landing_deadline_s",
        "max_flight_endurance_min"
      ],
      "properties": {
        "min_speed_kn_for_operation": { "type": "number", "minimum": 0.0 },
        "max_speed_kn_for_operation": { "type": "number", "minimum": 0.0 },
        "launch_recovery_min_speed_kn": { "type": ["number", "null"], "minimum": 0.0 },
        "launch_recovery_max_speed_kn": { "type": ["number", "null"], "minimum": 0.0 },
        "max_wind_kn_for_operation": { "type": "integer", "minimum": 0 },
        "max_sea_state_for_operation": { "type": "integer", "minimum": 0, "maximum": 9 },
        "requires_heading_into_wind_for_launch_recovery": { "type": "boolean" },
        "forbids_deck_machinery_while_active": { "type": "boolean" },
        "uses_deck_machinery": { "type": "boolean" },
        "requires_stern_ramp_free": { "type": "boolean" },
        "acoustic_hold_handshake_min_s": { "type": "integer", "minimum": 0 },
        "acoustic_hold_handshake_max_s": { "type": "integer", "minimum": 0 },
        "acoustic_hold_default_s": { "type": "integer", "minimum": 0 },
        "low_battery_threshold_pct": { "type": ["number", "null"], "minimum": 1.0, "maximum": 100.0 },
        "emergency_landing_deadline_s": { "type": ["integer", "null"], "minimum": 1 },
        "max_flight_endurance_min": { "type": ["integer", "null"], "minimum": 1 },
        "radar_tx_degradation_ratio": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
      }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requires_guests", "excludes_guests", "conditional_excludes"],
      "properties": {
        "requires_guests": { "type": "array", "items": { "type": "string" } },
        "excludes_guests": { "type": "array", "items": { "type": "string" } },
        "conditional_excludes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["other_guest_id", "when_self_modes", "when_other_modes", "reason"],
            "properties": {
              "other_guest_id": { "type": "string", "minLength": 1 },
              "when_self_modes": { "type": "array", "minItems": 1, "items": { "type": "string" } },
              "when_other_modes": { "type": "array", "minItems": 1, "items": { "type": "string" } },
              "reason": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "component_allocations": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "nominal_power_w",
            "sustained_power_w",
            "peak_power_w",
            "cooling_water_w",
            "cooling_air_w",
            "source_kind"
          ],
          "properties": {
            "min_power_w": { "type": "integer", "minimum": 0 },
            "nominal_power_w": { "type": "integer", "minimum": 0 },
            "sustained_power_w": { "type": "integer", "minimum": 0 },
            "peak_power_w": { "type": "integer", "minimum": 0 },
            "cooling_water_w": { "type": "integer", "minimum": 0 },
            "cooling_air_w": { "type": "integer", "minimum": 0 },
            "source_kind": {
              "type": "string",
              "enum": ["OFFICIAL_BRIEF", "ORGANIZER_ERRATA", "ASSUMED"]
            },
            "value_origin": {
              "type": "string",
              "enum": ["OFFICIAL_BRIEF", "ORGANIZER_ERRATA", "ASSUMED"]
            },
            "assumption_ref": { "type": "string" },
            "source_ref": { "type": "string" }
          }
        }
      }
    }
  }
}
