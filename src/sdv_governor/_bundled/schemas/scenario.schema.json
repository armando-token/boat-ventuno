{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdv-governor.local/schemas/scenario.schema.json",
  "title": "SDV Simulation Scenario Schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scenario_id", "name", "scenario_class", "seed", "initial_state", "events"],
  "properties": {
    "schema_version": { "type": "string", "const": "sdv-scenario/1.0" },
    "scenario_id": { "type": "string" },
    "name": { "type": "string" },
    "scenario_class": {
      "type": "string",
      "enum": [
        "OFFICIAL_CHALLENGE",
        "DECLARED_VARIANT",
        "STRESS_TEST",
        "STRESS_VARIANT",
        "UNIT_FIXTURE",
        "HISTORICAL",
        "PUBLIC_DATA_REPLAY"
      ]
    },
    "seed": { "type": "integer" },
    "initial_state": { "type": "object" },
    "events": { "type": "array" },
    "environment_profile": { "type": "object" },
    "observer_telemetry": { "type": "object" },
    "description": { "type": "string" },
    "notes": { "type": "string" },
    "purpose": { "type": "string" }
  }
}
