{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdv-governor.local/schemas/ship_profile.schema.json",
  "title": "SDV Ship Profile Schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "vessel_id",
    "vessel_name",
    "power",
    "cooling",
    "positions",
    "mast",
    "mass_and_stability",
    "data_links",
    "compute_rack",
    "time_deadlines"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "sdv-ship-baseline/1.0" },
    "vessel_id": { "type": "string", "minLength": 1 },
    "vessel_name": { "type": "string", "minLength": 1 },
    "power": { "type": "object" },
    "cooling": { "type": "object" },
    "positions": { "type": "object" },
    "mast": { "type": "object" },
    "mass_and_stability": { "type": "object" },
    "data_links": { "type": "object" },
    "compute_rack": { "type": "object" },
    "time_deadlines": { "type": "object" }
  }
}
